{
  "name": "docmole",
  "version": "0.4.4",
  "description": "Local markdown mirror + BM25 search for any documentation site, designed for CLI agents (Claude Code, Cursor)",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "docmole": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome check --write --unsafe src tests",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "docmole",
    "documentation",
    "docs",
    "cli",
    "bm25",
    "search",
    "claude",
    "claude-code",
    "cursor",
    "agent",
    "skills"
  ],
  "author": "Vigtu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vigtu/docmole.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.3.3",
    "jsdom": "^29.0.2",
    "turndown": "^7.2.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.3.0"
  }
}
